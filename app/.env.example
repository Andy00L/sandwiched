# The devnet sponsor keypair: either its JSON byte array (hosted deploys) or an absolute path to the file, kept outside the repository.
SANDWICH_SPONSOR_SECRET_KEY=
SANDWICH_SPONSOR_KEYPAIR_PATH=

# Upstash Redis REST endpoint and token (Upstash console, database Details tab). Shared rate limits and the sponsor spend budget.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
